# Example environment variables for Instagram Media Downloader
# Copy this file to .env and update the values.

# Instagram username used for data paths
# INSTAGRAM_USERNAME="username"

# Directory with Instagram export data
# DATA_DIR="/path/to/instagram-export/data"

# Target directory for downloads
# DOWNLOAD_DIR="/path/to/output"

# State directory for resume files
# STATE_DIR="./state"

# Delay between downloads in seconds
# REQUEST_DELAY="1.0"

# Max retry attempts
# MAX_RETRIES="3"

# Delay between retries in seconds
# RETRY_DELAY="5.0"

# Timeout per download in seconds
# TIMEOUT="60"

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL="INFO"

# Enable CSV export (true or false)
# CSV_EXPORT="true"
