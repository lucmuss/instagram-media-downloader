# Beispiel-Umgebungsvariablen für Instagram Media Downloader
# =======================================================
# Kopiere diese Datei nach .env und passe die Werte an.
# Stelle sicher, dass die .env-Datei in deiner .gitignore ist!

# Dein Instagram-Username (wird für Datenpfade verwendet)
# INSTAGRAM_USERNAME="skymuss"

# Verzeichnis mit Instagram-Export-Daten
# DATA_DIR="/pfad/zum/instagram-export/data"

# Ziel-Verzeichnis für Downloads
# DOWNLOAD_DIR="/pfad/zum/download/ordner"

# State-Verzeichnis (für Resume-Funktionalität)
# STATE_DIR="./state"

# Verzögerung zwischen Downloads (in Sekunden)
# Erhöhe diesen Wert bei Rate-Limit-Problemen
# REQUEST_DELAY="1.0"

# Maximale Anzahl von Wiederholungsversuchen bei Fehlern
# MAX_RETRIES="3"

# Verzögerung zwischen Wiederholungsversuchen (in Sekunden)
# RETRY_DELAY="5.0"

# Timeout für einzelne Downloads (in Sekunden)
# TIMEOUT="60"

# Log-Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL="INFO"

# CSV-Export aktivieren/deaktivieren (true/false)
# CSV_EXPORT="true"
